# ================================
# FIREBASE (Firestore + Storage)
# Consola de Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# Opción A: tres variables sueltas (la clave privada con \n literales, entre comillas)
# ================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opción B: el JSON completo de la cuenta de servicio en una sola línea (sustituye a las tres anteriores)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# ================================
# JWT
# ================================
# Obligatorio: el servidor no arranca sin él. En producción usa al menos 32 caracteres aleatorios.
JWT_SECRET=your_jwt_secret_here

# ================================
# SEGURIDAD
# ================================
# Orígenes (separados por comas) que pueden llamar a la API y al chat desde un navegador.
# Si se define, REEMPLAZA la lista por defecto (https://rob1e.netlify.app y, fuera de producción, localhost:5173).
# CORS_ORIGINS=https://rob1e.netlify.app,https://tu-dominio.com
# Número de proxies de confianza delante del servidor (para el límite de peticiones por IP).
# Por defecto: 1 si NODE_ENV=production (Render), 0 en local.
# TRUST_PROXY=1
# Solo para un servidor SMTP de pruebas con certificado autofirmado. Nunca en producción.
# SMTP_ALLOW_SELF_SIGNED=true

# ================================
# AUTENTICACIÓN CON GOOGLE
# ================================
GOOGLE_CLIENT_ID=your_google_client_id

# ================================
# STRIPE
# ================================
STRIPE_PRIVATE_KEY=sk_test_your_stripe_key

# ================================
# RESEND (correos)
# ================================
RESEND_API_KEY=your_resend_api_key
# Correo del administrador que recibe el aviso cuando un carpintero sube su CV (opcional)
ADMIN_NOTIFY_EMAIL=admin@example.com

# ================================
# ADMINISTRADOR INICIAL (solo lo usa: npm run crear-admin)
# ================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
ADMIN_NOMBRE=Administrador

# ================================
# URLS
# ================================
URL_BACKEND=http://localhost:4000/api/
URL_FRONTEND=http://localhost:5173/

# --- Emuladores de Firebase (desarrollo local, sin credenciales reales) ---
# Descomenta estas líneas y ejecuta `firebase emulators:start` en la raíz del proyecto
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_PROJECT_ID=demo-roble
# FIREBASE_STORAGE_BUCKET=demo-roble.appspot.com
